# Resend — waitlist email collection
# Create an API key at https://resend.com/api-keys and an audience at https://resend.com/audiences
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=aud_xxxxxxxxxxxxxxxxxx

# Public — safe to expose, inlined at build time
# Where the daily stats.json is published by scripts/sheet_to_stats.py. Leave empty pre-launch to use fallback.
NEXT_PUBLIC_STATS_URL=
# When the "since X" copy on Live Jar should anchor to. ISO date.
NEXT_PUBLIC_LAUNCH_DATE=2026-05-01
# Cloudflare Web Analytics beacon token (from the CF dashboard → Web Analytics)
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Python stats pipeline (only needed by scripts/sheet_to_stats.py)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gsheets_credentials.json
STATS_SHEET_ID=
STATS_SHEET_RANGE=LateJar!A2:C
STATS_OUT_PATH=stats.json
LAUNCH_DATE=2026-05-01
